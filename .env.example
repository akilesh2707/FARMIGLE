# Copy to `.env` and edit. `.env` is git-ignored; never commit real secrets.
#
# Every value below is the DEFAULT. With this file untouched the whole system
# runs in mock mode: no Google credentials, no network calls, deterministic
# results. `GET /health` reports which providers are actually in use.

# --- App -------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=false
# Empty means routes live at the root. Use /api/v1 to serve under a prefix.
API_PREFIX=
LOG_LEVEL=INFO
LOG_JSON=false
# Comma-separated. Leave empty for same-origin only.
CORS_ORIGINS=

# --- Demo vs. real services ------------------------------------------------
# true  = every Google-backed service is a local, clearly-labelled mock
# false = real providers; the required variables below must be set
MOCK_SERVICES=true

# --- Google Cloud (required when MOCK_SERVICES=false) ---------------------
# Point this at a service-account JSON. On Cloud Run, leave it empty and rely on
# the attached service account instead.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
FIREBASE_PROJECT_ID=
GCS_BUCKET=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Secrets ----------------------------------------------------------------
# Never logged and never returned by /health.
GEMINI_API_KEY=
WEATHER_API_KEY=

# --- Provider selection -----------------------------------------------------
# mock      = deterministic stand-ins, labelled `is_mock: true`
# heuristic = real OpenCV colour/texture models (no weights needed)
# yolo      = real Ultralytics detector; REQUIRES FRUIT_DETECTOR_WEIGHTS
ML_PROVIDER=mock
# Ripeness and health can override the shared switch individually.
ML_RIPENESS_PROVIDER=mock
ML_HEALTH_PROVIDER=mock
# Path to trained weights, e.g. data/weights/mango_yolo.pt
FRUIT_DETECTOR_WEIGHTS=
ML_DEVICE=cpu

GEMINI_PROVIDER=mock          # mock | vertex
GEMINI_MODEL=gemini-2.0-flash
# seeded   = deterministic demo values, no network
# open_meteo = live, no API key
# google  = live, needs GOOGLE_CLOUD_LOCATION
WEATHER_PROVIDER=seeded
# seeded       = deterministic demo values from data/satellite
# earth_engine = live; also set EARTH_ENGINE_ALLOW_LIVE=true
SATELLITE_PROVIDER=seeded
EARTH_ENGINE_ALLOW_LIVE=false
SPEECH_PROVIDER=mock          # mock | google

# --- Local paths (relative to the repository root) -------------------------
LOCAL_STORAGE_DIR=.local_data/storage
SEED_DATA_DIR=data/seed
SATELLITE_DATA_DIR=data/satellite
CONFIG_DIR=configs

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=12582912
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/bmp

# --- Domain defaults -------------------------------------------------------
DEFAULT_CROP=mango
DEFAULT_LANGUAGE=ta

# ===========================================================================
# Development tokens. Accepted ONLY while MOCK_SERVICES=true.
#   Bearer dev-farmer-token   -> farmer, uid dev_farmer_001
#   Bearer dev-officer-token  -> district officer, uid dev_officer_001
# Never enable mock services in a deployed environment.
# ===========================================================================
